{
  "$schema": "./schemas/vioraharness.schema.json",
  "compaction": {
    "keepTail": 20,
    "threshold": 0.8
  },
  "permissions": {
    "apply_patch": "ask",
    "bash": "allow",
    "bash cd*": "allow",
    "bash curl*": "allow",
    "bash dd*": "ask",
    "bash fdisk*": "ask",
    "bash fuser*": "allow",
    "bash google-chrome*": "allow",
    "bash halt*": "ask",
    "bash kill*": "allow",
    "bash mkfs*": "ask",
    "bash mkswap*": "ask",
    "bash nohup*": "allow",
    "bash parted*": "ask",
    "bash pkill*": "allow",
    "bash poweroff*": "ask",
    "bash ps*": "allow",
    "bash python3*": "allow",
    "bash reboot*": "ask",
    "bash rm*": "ask",
    "bash rmdir*": "ask",
    "bash shred*": "ask",
    "bash shutdown*": "ask",
    "bash sleep*": "allow",
    "bash srm*": "ask",
    "bash sudo:*": "deny",
    "bash unlink*": "ask",
    "bash which*": "allow",
    "bash wipe*": "ask",
    "bash wipefs*": "ask",
    "bash wmctrl -c*": "ask",
    "bash wmctrl --close*": "ask",
    "bash xdotool windowclose*": "ask",
    "bash xdotool windowkill*": "ask",
    "bash xdotool windowunmap*": "ask",
    "browser_dom": "allow",
    "browser_open": "ask",
    "browser_pdf": "allow",
    "browser_screenshot": "allow",
    "dev_serve": "allow",
    "adb_devices": "allow",
    "adb_install": "ask",
    "adb_logcat": "allow",
    "adb_pull": "allow",
    "adb_push": "allow",
    "adb_screenshot": "allow",
    "adb_shell": "ask",
    "autofix": "ask",
    "autofix-file": "ask",
    "drc": "allow",
    "emulator": "allow",
    "gradle": "ask",
    "edit": "ask",
    "erc": "allow",
    "ext-create": "ask",
    "flux": "allow",
    "footprint-list": "allow",
    "footprint-render": "allow",
    "footprint_import": "allow",
    "footprint-import": "allow",
    "footprint_list": "allow",
    "footprint_render": "allow",
    "glob": "allow",
    "grep": "allow",
    "netlist-compare": "allow",
    "netlist-run": "allow",
    "netlist-run --measure": "allow",
    "netlist-to-schematic": "allow",
    "netlist-validate": "allow",
    "netlist_compare": "allow",
    "netlist_run": "allow",
    "netlist_to_schematic": "allow",
    "netlist_validate": "allow",
    "pcb-autoroute": "ask",
    "pcb-cleanup": "allow",
    "pcb-compose": "allow",
    "pcb-compose --auto-route": "ask",
    "pcb-export": "allow",
    "pcb-init": "allow",
    "pcb-netlist": "allow",
    "pcb-query": "allow",
    "pcb-render": "allow",
    "pcb-sync": "allow",
    "pcb_autoroute": "ask",
    "pcb_cleanup": "allow",
    "pcb_compose": "allow",
    "pcb_compose --auto-route": "ask",
    "pcb_export": "allow",
    "pcb_init": "allow",
    "pcb_netlist": "allow",
    "pcb_query": "allow",
    "pcb_render": "allow",
    "pcb_sync": "allow",
    "pcb_validate": "allow",
    "process": "ask",
    "question": "allow",
    "raw-info": "allow",
    "raw-stats": "allow",
    "raw_export": "allow",
    "raw_info": "allow",
    "raw_stats": "allow",
    "read": "allow",
    "schematic-bom": "allow",
    "schematic-diff": "allow",
    "schematic-netlist": "allow",
    "schematic-query": "allow",
    "schematic-render": "allow",
    "schematic-transform": "ask",
    "schematic-validate": "allow",
    "schematic_bom": "allow",
    "schematic_diff": "allow",
    "schematic_netlist": "allow",
    "schematic_query": "allow",
    "schematic_render": "allow",
    "schematic_transform": "ask",
    "schematic_validate": "allow",
    "skill": "allow",
    "symbol-list": "allow",
    "symbol-render": "allow",
    "symbol-search": "allow",
    "symbol-validate": "allow",
    "symbol_list": "allow",
    "symbol_render": "allow",
    "symbol_search": "allow",
    "symbol_validate": "allow",
    "task": "allow",
    "todowrite": "allow",
    "viora": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "write": "ask"
  },
  "provider": {
    "gemini": {
      "apiKeyEnv": "GEMINI_API_KEY",
      "baseURL": "https://generativelanguage.googleapis.com/v1beta",
      "models": []
    },
    "openrouter": {
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "baseURL": "https://openrouter.ai/api/v1",
      "models": []
    },
    "opencode": {
      "apiKeyEnv": "OPENCODE_API_KEY",
      "baseURL": "https://opencode.ai/zen/v1",
      "models": []
    },
    "opencode-go": {
      "apiKeyEnv": "OPENCODE_API_KEY",
      "baseURL": "https://opencode.ai/zen/go/v1",
      "models": []
    }
  },
  "sandbox": "strict",
  "activeMode": "eda",
  "session": {
    "dbPath": "~/.local/share/vioraharness/sessions.db",
    "tracesDir": "~/.local/share/vioraharness/traces"
  },
  "theme": {
    "accent": "#e0c9a6",
    "background": "#1e1c1a",
    "backgroundElement": "#2f2b28",
    "backgroundPanel": "#252220",
    "border": "#3a3632",
    "borderActive": "#c9a86a",
    "borderSubtle": "#252220",
    "error": "#d98c8c",
    "info": "#c9a86a",
    "primary": "#c9a86a",
    "secondary": "#d4b896",
    "success": "#a8c090",
    "text": "#d6c7b8",
    "textMuted": "#8a7d6b",
    "warning": "#e0b88c"
  },
  "tui": {
    "show_thinking": true,
    "theme": "eye-comfort",
    "thinkingOpacity": 0.5,
    "thinking_label": "Reasoning",
    "thinking_title": "Thinking",
    "tool_display": {
      "default": "compact"
    }
  }
}
